# Maintainer: lu5je0 <lu5je0@gmail.com>
pkgname=arcglyph
pkgver=0.6.0
pkgrel=1
pkgdesc="Elegant right-click mouse-gesture daemon for Wayland (KDE Plasma & GNOME)"
arch=('x86_64')
url="https://github.com/lu5je0/arcglyph"
license=('MIT')
depends=('gcc-libs' 'glibc' 'wayland' 'libxkbcommon' 'dbus' 'fontconfig')
makedepends=('cargo' 'pkgconf')
optdepends=('vulkan-icd-loader: GPU-accelerated overlay rendering'
            'kwin: focused-window detection on KDE Plasma'
            'gnome-shell: GNOME support via bundled helper extension (arcglyph --install-gnome-extension)')
install="$pkgname.install"
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f7febc64cc0927458cd2b462b5ac5ae2debc12d2ed60a5780af26bedce1c0432')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "packaging/$pkgname.desktop" \
    "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 "packaging/60-$pkgname-uinput.rules" \
    "$pkgdir/usr/lib/udev/rules.d/60-$pkgname-uinput.rules"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
